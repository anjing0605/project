{
  "dataset": {
    "family": "Planetoid",
    "name": "Cora",
    "root": "D:/project/keynode/project/public_datasets/Planetoid",
    "importance_path": "D:/project/keynode/project/public_process/extract/Cora_struct/gnn_node_scores_mean.csv",
    "node_features_path": "D:/project/keynode/project/public_process/extract/Cora_struct/node_features.csv",
    "old_id_col_in_node_features": "node",
    "community_mode": "louvain",
    "strict_importance_alignment": true,
    "importance_fill_value": 0.0,
    "verbose": true
  },
  "keynode": {
    "mode": "topk",
    "k": 30,
    "min_shortest_len": 2,
    "max_pairs": 200
  },
  "paths": {
    "k_shortest": 3,
    "max_hops": 8,
    "delta": 2,
    "top_q": 10,
    "overlap_threshold": 0.6
  },
  "fragility": {
    "lambda_E": 0.4,
    "lambda_LCC": 0.4,
    "lambda_ASP": 0.2
  },
  "ranking": {
    "train_ratio": 0.8,
    "top_per_task": 1,
    "random_state": 42,
    "feature_cols": [
      "shortest_len",
      "same_community",
      "pair_score",
      "candidate_rank",
      "path_length_int",
      "avg_node_importance",
      "internal_node_importance",
      "avg_edge_bc",
      "cross_comm_ratio",
      "path_length",
      "num_edges"
    ],
    "xgb_params": {
      "n_estimators": 300,
      "max_depth": 4,
      "learning_rate": 0.05,
      "subsample": 0.9,
      "colsample_bytree": 0.9,
      "reg_alpha": 0.0,
      "reg_lambda": 1.0,
      "random_state": 42,
      "objective": "reg:squarederror"
    }
  },
  "tensorboard": {
    "enabled": true,
    "log_root": "outputs/tb",
    "run_name": "cora_rank"
  },
  "output": {
    "k_list": [
      1,
      3,
      5,
      10
    ],
    "top_n_summary": 10,
    "metrics_json": "outputs/metrics/cora_rank_metrics.json",
    "paths_json": "outputs/paths/cora_rank_paths.json",
    "dataset_csv": "outputs/metrics/cora_rank_dataset.csv",
    "scored_test_csv": "outputs/metrics/cora_rank_scored_test.csv"
  }
}